{
  "version": 2,
  "name": "stragentech-apps",
  "rewrites": [
    {
      "source": "/api/analyze",
      "destination": "/api/analyze.js"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tools.stragentech.com"
        }
      ],
      "destination": "/tools.html",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "apps.stragentech.com"
        }
      ],
      "destination": "https://tools.stragentech.com/:path*",
      "permanent": true
    }
  ]
}
